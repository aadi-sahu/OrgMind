# Copy to .env.local to override.

# mock = sample data from src/mocks, no network calls (default)
# http = real requests to the FastAPI backend
VITE_API_MODE=mock

# Path prefix (or absolute URL) for backend requests in http mode.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api during local development.
VITE_API_PROXY_TARGET=http://localhost:8000
